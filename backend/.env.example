PORT=3001
NODE_ENV=development
DEV_FRONTEND_ORIGIN=http://localhost:5173
# PostgreSQL is local-only during migration testing. Keep this value in backend/.env.
# Use a dedicated database role; never put this URL in a VITE_ variable.
DATABASE_URL=postgresql://school_visit_app:replace-with-password@127.0.0.1:5433/school_visit_local
# Optional: installed CorelDRAW COM version used for native CDR export on Windows.
CORELDRAW_PROG_ID=CorelDRAW.Application.25
ADMIN_EMAIL=admin@portal.com
ADMIN_NAME=Muhammad Ali Ashfaq
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
SESSION_SECRET=replace-with-at-least-32-random-characters
# Generate once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Set these on the hosted API too. Keep the private key out of frontend files and Git.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@portal.com
