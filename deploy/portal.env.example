# API settings. Copy to /opt/jp-portal/portal.env (chmod 600).
DATABASE_URL=postgresql://portal:replace-with-same-password@db:5432/portal
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Portal Admin
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
